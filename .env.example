# Klaviyo (server-side only; never commit .env*.local)
KLAVIYO_PRIVATE_API_KEY=
# Contact form — all CTAs subscribe here (email + marketing subscribe)
KLAVIYO_LIST_ID=

# Supabase (blog posts + cover images)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Blog admin (shared password; generate a long random ADMIN_SESSION_SECRET)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Vercel cron — scheduled post publishing
CRON_SECRET=

# Shopify Storefront API (public, read-only token from the Headless sales channel)
# Products must be published to that channel to appear in the homepage shop banner.
SHOPIFY_STOREFRONT_TOKEN=
# Optional overrides
SHOPIFY_STORE_DOMAIN=omnia-fitness-collective.myshopify.com
SHOPIFY_API_VERSION=2026-04
